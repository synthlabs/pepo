{
	"name": "pepo",
	"version": "0.2.33",
	"private": false,
	"scripts": {
		"build": "pnpm run check && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:window-controls": "node scripts/diagnostics/window-controls.mjs",
		"dev": "vite dev",
		"format": "node scripts/format.mjs --write",
		"format:check": "node scripts/format.mjs --check",
		"lint": "node scripts/lint.mjs",
		"lint:tailwind-classes": "node scripts/lint-tailwind-classes.mjs",
		"preview": "vite preview",
		"tauri": "tauri",
		"test:unit": "svelte-kit sync && vitest run --config vitest.config.ts",
		"test:scripts": "node --test tests/scripts/*.test.mjs",
		"test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
		"test:rust:build": "cargo test --locked --manifest-path src-tauri/Cargo.toml --no-run",
		"test:packaging": "node tests/packaging/run.mjs",
		"test:browser": "playwright test --config playwright.config.ts",
		"test:internal": "node internal/internal-test.mjs",
		"test": "pnpm test:unit && pnpm test:scripts && pnpm test:rust && pnpm test:packaging && pnpm test:browser && pnpm test:internal",
		"verify": "pnpm check && pnpm lint && pnpm build && pnpm test && cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings && git diff --check && git -C utils diff --check"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.77.0",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "^2.12.6",
		"@types/node": "^26.6.6",
		"bits-ui": "2.22.0",
		"clsx": "^2.1.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.8",
		"vitest": "5.1.1",
		"yaml": "2.9.1"
	},
	"type": "module",
	"dependencies": {
		"@tauri-apps/api": "^2.12.5",
		"@tauri-apps/plugin-log": "^2.10.2",
		"@tauri-apps/plugin-opener": "^2.7.3",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-store": "^2.5.1",
		"@tauri-apps/plugin-updater": "^2.14.1",
		"@tauri-apps/plugin-window-state": "^2.5.0",
		"tauri-svelte-synced-store": "github:synthlabs/tauri-svelte-synced-store"
	},
	"packageManager": "pnpm@12.23.0"
}
