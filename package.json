{
	"name": "pepo",
	"version": "0.2.28",
	"private": false,
	"scripts": {
		"build": "pnpm run check && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:window-controls": "node scripts/check-window-controls.mjs",
		"dev": "vite dev",
		"format": "node scripts/format.mjs --write",
		"format:check": "node scripts/format.mjs --check",
		"lint": "node scripts/lint.mjs",
		"lint:tailwind-classes": "node scripts/lint-tailwind-classes.mjs",
		"preview": "vite preview",
		"tauri": "tauri",
		"test": "svelte-kit sync && vitest",
		"test:run": "svelte-kit sync && vitest run && node --test scripts/check-window-controls.test.mjs scripts/lint-tailwind-classes.test.mjs scripts/ci.test.mjs utils/scripts/update-utils-submodules.test.mjs utils/js/inbound/controller.test.mjs",
		"test:ci": "node --test scripts/ci.test.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^25.9.9",
		"bits-ui": "2.18.0",
		"clsx": "^2.1.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^27.4.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.5",
		"vitest": "^3.2.7",
		"yaml": "2.9.1"
	},
	"type": "module",
	"dependencies": {
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-log": "^2.10.1",
		"@tauri-apps/plugin-opener": "^2.7.2",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-store": "^2.5.0",
		"@tauri-apps/plugin-updater": "^2.14.0",
		"@tauri-apps/plugin-window-state": "^2.5.0",
		"tauri-svelte-synced-store": "github:synthlabs/tauri-svelte-synced-store"
	},
	"packageManager": "pnpm@11.18.0"
}
