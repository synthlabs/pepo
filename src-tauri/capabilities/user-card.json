{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "user-card",
	"description": "Identity card windows",
	"windows": ["user-card-*"],
	"permissions": [
		"core:default",
		"core:window:allow-close",
		"core:window:allow-start-dragging",
		"core:window:allow-set-theme",
		"log:default",
		"store:default",
		{ "identifier": "opener:allow-open-url", "allow": [{ "url": "https://www.twitch.tv/*" }] },
		"inbound:default"
	]
}
